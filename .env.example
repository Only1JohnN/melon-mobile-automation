# Copy this file to .env and fill in real values. .env is gitignored.

# Path to the Melon app APK, relative to project root.
# Drop the built APK into ./apps and point this at it.
APP_PATH=./apps/melon.apk

# Name of the Android emulator AVD to boot for local runs.
ANDROID_AVD_NAME=Melon_Test

# Android platform version reported by the emulator/device.
ANDROID_PLATFORM_VERSION=15

# Set to "true" to boot the emulator with no GUI window (still fully
# controlled by Appium, just not visible) — lighter on a resource-tight
# machine. Leave unset to see the emulator like normal.
ANDROID_EMULATOR_HEADLESS=

# Staging test account used by test/specs/melon/login.spec.ts
TEST_PHONE_NUMBER=
TEST_PIN=

# Second staging test account — used as the share-coin recipient in
# test/specs/melon/shareCoins.spec.ts, so we can verify the coins and
# notification actually land on the other side.
TEST_PHONE_NUMBER_2=
TEST_PIN_2=
# Its Melon ID (Profile screen), used as the share-coin recipient identifier.
TEST_MELON_ID_2=
